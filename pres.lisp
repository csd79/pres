;; ----------------------------------------------------------------------
;; Utils


(defun hudate->plist (hudate)
  "'(2026 10 15)  =>  '(:year 2026 :month 10 :date 15 :weekday 'Csütörtök')"
  (let ((weekdays '("Hétfõ" "Kedd" "Szerda" "Csütörtök" "Péntek" "Szombat" "Vasárnap")))
    (multiple-value-bind (second minute hour date month year day daylight-p zone)
        (decode-universal-time (hudate->unitime hudate))
      (declare (ignore second minute hour daylight-p zone))
      (let ((workday-p (actual-workday-p hudate)))
        (list :year year :month month :date date
              :weekday (nth day weekdays)
              :workday workday-p
              :last-workday (when workday-p
                              (last-workday-of-week-p hudate)))))))

(defun days-of-month (year/ month/ &key (workdays-only nil))
  "List the days of given month, each represented as a plist generated by HUDATE->PLIST."
  (let* ((month-days '(31 28 31 30 31 30 31 31 30 31 30 31))
         (last-day   (if (and (= month/ 2) (leap-year-p year/))
                       29
                       (nth (1- month/) month-days))))
    (loop for d from 1 upto last-day
          for plist = (hudate->plist (list year/ month/ d))
          when (or (not workdays-only)
                   (getf plist :workday))
          collecting plist)))


(defmethod daylist ((obj wax-app))
  "Generate list of days for the month required on the GUI."
  (days-of-month (get-state obj :year)
                 (get-state obj :month)
                 :workdays-only (not (get-state obj :disp-holidays))))


(defmethod daycount ((obj wax-app))
  "Number of days in required month."
  (length (daylist obj)))


(defmethod namelist ((obj wax-app))
  "List of names loaded from the namelist spreadsheet."
  (xacolumn (source-data obj :namelist) "Név"))


(defmethod namecount ((obj wax-app))
  "Number of names loaded from the namelist spreadsheet."
  (length (namelist obj)))


(defmethod pagecount ((obj wax-app))
  "Number of pages needed to display every loaded name."
  (ceiling (/ (namecount obj) *page-width*)))


(defmethod page-data-start ((obj wax-app) page)
  "First row of first day on given PAGE."
  (+ (* (1- page) (+ (daycount obj) 2) 2) 5))


(defmethod page-data-end ((obj wax-app) page)
  "Last row of last day on given PAGE."
  (- (page-data-start obj (1+ page)) 5))


(defun pos-first-col (pos)
  (+ 3 (* (1- pos) 3)))


(defun page-last-col ()
  "Last column (same everywhere)."
  (+ (* *page-width* *col-width*) 2))


(defmethod stepper ((obj pres) n &key (abs nil))
  (setf (progr obj)
        (if abs
          n
          (+ (progr obj) n)))
  (setf (capi:range-slug-start (pbar obj))
        (min 100 (round (progr obj)))))





;; ----------------------------------------------------------------------
;; Constructing output


(defparameter *accent-color* (rgb 247 150 70))


(defun left-border (wsheet obj &optional (page 1))
  "Construct left border containing days and 'Arrival/Departure' labels."
  (let* ((days (daylist obj))
         (data-start (page-data-start obj page))
         (data-end   (page-data-end obj page))
         (day-start  (- data-start 3))
         (day-end    (+ day-start 2)))
    (setf (xcell wsheet :a day-start) "Nap")
    (set-font wsheet :a day-start :b day-start :bg *accent-color*)
    ;; A: dates and weekdays
    (loop for plist in days
          for r from data-start by 2
          for date = (getf plist :date)
          for short = (short-weekday (getf plist :weekday))
          doing (setf (xcell wsheet :a r) (format nil "'~a. ~a" date short)))
    ;; B: arrival/departure
    (loop for r from data-start upto data-end doing
          (setf (xcell wsheet :b r) (if (oddp r) "Érkezés" "Távozás")))
    ;; Styling
    (set-align-grid wsheet :a day-start :b data-end :ha :center :va :center :hl t :vl t :around t)
    (set-font wsheet :a day-start :a data-end :bold t)
    (set-font wsheet :b day-start :b data-end :size 7)
    (loop for r from (1+ day-start) below data-end by 2 doing
          (merge-range wsheet :a r :a (1+ r)))
    (merge-range wsheet :a day-start :a day-end)
    (merge-range wsheet :b day-start :b day-end)
    (set-col-widths wsheet :a 9.14 5.14)))


(defun page-header (wsheet obj &optional (page 1))
  "Construct Organizational unit and object month rows."
  (let* ((year      (get-state obj :year))
         (month     (nth (1- (get-state obj :month))
                         '("Január" "Február" "Március" "Április" "Május" "Június"
                           "Július" "Augusztus" "Szeptember" "Október" "November" "December")))
         (unit-row  (- (page-data-start obj page) 4))
         (unit-col1 1)
         (mon-row   (1+ unit-row))
         (mon-col1  3)
         (mon-colx  (page-last-col)))
    ;; Org. unit header
    (setf (xcell wsheet unit-col1 unit-row) (format nil "    Klebelsberg Központ - ~a" (get-state obj :unit)))
    (set-font wsheet unit-col1 unit-row unit-col1 unit-row :bold t :size 12)
    ;; Month header
    (setf (xcell wsheet mon-col1 mon-row) (string-upcase (format nil "~a. ~a hó" year month)))
    (set-font wsheet mon-col1 mon-row mon-colx mon-row :bold t :bg *accent-color*)
    (set-align-grid wsheet mon-col1 mon-row mon-colx mon-row :ha :cacross :va :center :hl nil :vl nil :around t)))


(defun name-header (wsheet obj name pos &optional (page 1))
  "Contain header for names and their sub-headers (Time, Abselce code, Signature)."
  (let* ((name-row (- (page-data-start obj page) 2))
         (subs-row (1+ name-row))
         (col1     (pos-first-col pos))
         (col3     (+ col1 2)))
    ;; Name
    (setf (xcell wsheet col1 name-row) name)
    (set-font wsheet col1 name-row col3 name-row :bold t)
    (set-align-grid wsheet col1 name-row col3 name-row
                    :ha :cacross :va :center :wrap t :hl t :vl t :around t)
    ;; Sub-headers
    (setf (xrange wsheet col1 subs-row col3 subs-row)
          #2A(("Óra, perc" "Távollét oka" "Aláírás")))
    (set-font wsheet col1 subs-row col3 subs-row :size 7)
    (set-align-grid wsheet col1 subs-row col3 subs-row
                    :ha :center :va :center :hl t :vl t :around t)
    (set-col-widths wsheet col1 6.86 6.57 9.00)))


(defun add-cell-note (wsheet column row string)
  (cclet* ((cell (range wsheet column row)))
    (!'addcomment cell string)
    (cclet* ((textframe (?'textframe (?'shape (?'comment cell))))
             (font      (?'font (!'characters textframe))))
      (setf (?'name font) "Courier New"
            (?'size font) 9
            (?'autosize textframe) t))))


(defun name-column (wsheet obj name pos &optional (page 1))
  (let* ((days     (daylist obj))
         (1st-row  (page-data-start obj page))
         (last-row (page-data-end obj page))
         (col1     (pos-first-col pos))
         (col2     (1+ col1))
         (row      (select-row-from obj :namelist #'(lambda (row) (string= (xcref row "Név") name))))
         (list*    (format nil "~{~a~^;~}" (ccoffice::xacolumn (source-data obj :absence-types) "Rövidítés")))
         (note     (substitute #\Newline #\& (format nil "~{~a~^&~}" (get-state obj :absence-note)))))
    ;; Going down the rows
    (unless (string= name "")
      (let ((value-array (make-array `(,(* (length days) 2) 2) :initial-element "")))
        (loop for r from 0 by 2
              for (nil nil nil nil nil nil nil nil nil workday nil last-workday) in days
              for arrival = (cond (last-workday (xcref row "Érkezés P"))
                                  (workday      (xcref row "Érkezés H-Cs"))
                                  (t            ""))
              for departure = (cond (last-workday (xcref row "Távozás P"))
                                    (workday      (xcref row "Távozás H-Cs"))
                                    (t            ""))
              for perm-abs = (xcref row "Tartós távollét kód")
              for perm-abs-provided = (not (empty-cell-p perm-abs))
              doing
              ;; Insert arrival/departure times
              (setf (aref value-array r 0) arrival
                    (aref value-array (1+ r) 0) departure)
              ;; Insert permanend absence code
              (when perm-abs-provided
                (setf (aref value-array r 1) perm-abs)))
        ;; Assigning the built-up array to region
        (setf (xrange wsheet col1 1st-row col2 last-row) value-array)))
    ;; Add notes to absence column
    (loop for d in days
          for r from 1st-row by 2 doing
          ;(declare (ignore d))
          (add-cell-note wsheet col2 r note))
    ;; Style columns
    (set-numform wsheet col1 1st-row col1 last-row "ó:pp")
    (set-align-grid wsheet col1 1st-row (1+ col2) last-row :ha :center :va :center :hl t :vl t :around t)
    ;; Set list validation for absence code
    (set-validation wsheet col2 1st-row col2 last-row :list :noalert :between list*)
    ;; Merge absence cells into one
    (loop for r from 1st-row upto last-row by 2 doing (merge-range wsheet col2 r col2 (1+ r)))))

