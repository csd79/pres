(defun construct (obj)
  "Construct pages & set their size for printing."
  ;; Initialize progress bar
  (stepper obj 0 :abs t)
  (with-workbook (:wbook wbook :wsvars (ws1) :close nil)
    (cclet* ((excel (?'application wbook)))
;      (excellerate ((?'application wbook) :all nil)
      (with-excel-automation ((?'application wbook) :all nil)
        (all-name-columns ws1 obj)
;        (setf (?'printcommunication excel) nil)
        (accentuate-holidays ws1 obj)
        (set-page ws1 :size :a3 :orientation :landscape :mtop 1.5 :mbottom 1.5)
;      (set-page-zoom ws1 :zoom 100)
        (set-print-area ws1 :a 1 (page-last-col) (page-data-end obj (pagecount obj)))
        (let ((breakes (loop for page from 1 below (pagecount obj) collecting
                             (list :row (page-data-end obj page)))))
          (apply #'new-pagebreaks ws1 (apply #'append breakes)))
        (set-page-zoom ws1 :fit-width t))
;        (setf (?'printcommunication excel) t))
      (setf (?'visible (?'application wbook)) t)
      )))





;; ----------------------------------------------------------------------
;; Main


(defparameter *pkeys* '(:namelist-file :disp-holidays :year :month :unit))


(defclass pres (wax-app)
  ((progr :accessor progr :initform 0)
   (pbar  :accessor pbar  :initARG :pbar)))


(defun pres-start ()
  ;; App object ---------------------------------------------------------
;  (let ((obj (make-instance 'wax-app
  (let* ((pbar (make-instance 'capi:progress-bar :start 0 :end 100))
         (obj  (make-instance 'pres
                :state `(:irreg-file     ,(appfile "_irreg.lisp")
                         :params-file    ,(appfile "_params.lisp")
                         :namelist-file  ,(user-homedir)
                         :disp-holidays  t
                         :year           nil
                         :month          nil
                         :unit           ""
                         :prog           0
                         :stepper        nil)
                :execute-fn
                #'(lambda (obj &rest args)
                    (declare (ignore args))
                    
                    ;; Adding contents of _params to state
                    (setf (state obj)
                          (append (state obj)
                                  (car (load-forms (get-state obj :params-file) :count 1))))
                    ;; Loading irregulars
                    (destructuring-bind (extra-holidays extra-workdays)
                        (load-forms (get-state obj :irreg-file) :count 2)
                      (let ((*extra-holidays* extra-holidays)
                            (*extra-workdays* extra-workdays))
                        ;; Loading namelist file
                        (add-data-source obj :namelist (get-state obj :namelist-file))
                        (load-data-source obj :namelist)
                        (add-data-source obj :absence-types (get-state obj :namelist-file) 2)
                        (load-data-source obj :absence-types)
                        ;; Main thing
                        (construct obj)
                        ;; Cleanup
                        (purge-data-source obj :namelist))))
                :pbar   pbar)))

    (load-state obj :keys *pkeys*)
    ;; GUI --------------------------------------------------------------
    (wg-window
     `(:title "Jelenlét nyilvántartás"
       :max-height 80
       :best-width 650)

      "Névlista"
      (wg-file-selector
       "Névlista"
       "*.xlsx" '("Excel fájlok" "*.xlsx" "Minden fájl" "*.*")
       #'(lambda (text &rest rest)
           (declare (ignore rest))
           (setf (get-state obj :namelist-file) text))
       (get-state obj :namelist-file))

      "Év"
      (wg-text-input 
       #'(lambda (text &rest rest)
           (declare (ignore rest))
           (let ((year/ (parse-integer text :junk-allowed t)))
             (when (and (integerp year/)
                      (<= 1900 year/ 9999))
               (setf (get-state obj :year) year/))))
       (format nil "~a" (get-state obj :year)))

      "Hónap"
      (wg-text-input 
       #'(lambda (text &rest rest)
           (declare (ignore rest))
           (let* ((num-month (parse-integer text :junk-allowed t))
                  (month     (if (and (integerp num-month)
                                      (<= 1 num-month 12))
                               num-month
                               (identify-month text))))
             (when month
               (setf (get-state obj :month) month))))
       (format nil "~a" (get-state obj :month)))

      "Szervezeti egység"
      (wg-text-input 
       #'(lambda (text &rest rest)
           (declare (ignore rest))
           (setf (get-state obj :unit) text))
       (format nil "~a" (get-state obj :unit)))

#|      ""
      (wax::wg-checkbox
       "Munkaszüneti napok"
       #'(lambda (data)
           (setf (get-state obj :disp-holidays) data))
       (get-state obj :disp-holidays))|#
      
      ""
      (wg-button "Generálás"
        #'(lambda (interface)
            (declare (ignore interface))
            (save-state obj :keys *pkeys*)
            (wax-execute obj :errorsink-on nil)))

      ""
      pbar
      )))





