(defparameter *extra-holidays* '())
(defparameter *extra-workdays* '())


#|(defparameter *extra-holidays* '("2026.01.01"
                                 "2026.01.02"
                                 "2026.04.03"
                                 "2026.04.06"
                                 "2026.05.01."
                                 "2026.05.25"
