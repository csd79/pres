(defun leap-year-p (year)
  (or (zerop (mod year 400))
      (and (zerop (mod year 4))
           (not (zerop (mod year 100))))))


(defun weekend-p (hudate)
  (multiple-value-bind (second minute hour date month year day daylight-p zone)
      (decode-universal-time (hudate->unitime hudate))
    (declare (ignore second minute hour date month year daylight-p zone))
    (member day '(5 6))))


(defun extra-holiday-p (hudate)
  (some #'(lambda (datestring)
            (equal hudate (parse-hudate datestring)))
        *extra-holidays*))


(defun extra-workday-p (hudate)
  (some #'(lambda (datestring)
            (equal hudate (parse-hudate datestring)))
        *extra-workdays*))


(defun actual-workday-p (hudate)
  (or (extra-workday-p hudate)
      (not (or (extra-holiday-p hudate)
               (weekend-p hudate)))))


(defun last-day-of-week (hudate)
  (destructuring-bind (year/ month/ day/)
      hudate
    (let* ((ut-today  (encode-universal-time 0 0 12 day/ month/ year/))
           (day-today (seventh (multiple-value-list (decode-universal-time ut-today)))))
      (nreverse (subseq (multiple-value-list (decode-universal-time (+ ut-today (* (- 6 day-today) 86400))))
                        3 6)))))


(defun last-workday-of-week (hudate)
  (let ((ut-sunday (apply #'encode-universal-time 0 0 0 (reverse (last-day-of-week hudate)))))
    (loop for ldut from ut-sunday downto (- ut-sunday (* 6 86400)) by 86400
          for rhudate = (subseq (multiple-value-list (decode-universal-time ldut)) 3 6)
          for hd = (nreverse rhudate)
          until (actual-workday-p hd)
          finally (return hd))))
           

(defun last-workday-of-week-p (hudate)
  (equalp hudate (last-workday-of-week hudate)))
  

(defun hudate->plist (hudate)
  "'(2026 10 15)  =>  '(:year 2026 :month 10 :date 15 :weekday 'Csütörtök')"
  (let ((weekdays '("Hétfõ" "Kedd" "Szerda" "Csütörtök" "Péntek" "Szombat" "Vasárnap")))
    (multiple-value-bind (second minute hour date month year day daylight-p zone)
        (decode-universal-time (hudate->unitime hudate))
      (declare (ignore second minute hour daylight-p zone))
      (let ((workday-p (actual-workday-p hudate)))
        (list :year year :month month :date date
              :weekday (nth day weekdays)
              :workday workday-p
              :last-workday (when workday-p
                              (last-workday-of-week-p hudate)))))))


(defun days-of-month (year/ month/ &key (workdays-only nil))
  "List the days of given month, each represented as a plist generated by HUDATE->PLIST."
  (let* ((month-days '(31 28 31 30 31 30 31 31 30 31 30 31))
         (last-day   (if (and (= month/ 2) (leap-year-p year/))
                       29
                       (nth (1- month/) month-days))))
    (loop for d from 1 upto last-day
          for plist = (hudate->plist (list year/ month/ d))
          when (or (not workdays-only)
                   (getf plist :workday))
          collecting plist)))





;; ----------------------------------------------------------------------
;; Excel utils


(defparameter *alignments* `(:center  ,ccoffice::+xl-halign-center+
                             :cacross ,ccoffice::+xl-halign-center-across-selection+
                             :distr   ,ccoffice::+xl-halign-distributed+
                             :fill    ,ccoffice::+xl-halign-fill+
                             :general ,ccoffice::+xl-halign-general+
                             :just    ,ccoffice::+xl-halign-justify+
                             :left    ,ccoffice::+xl-halign-left+
                             :right   ,ccoffice::+xl-halign-right+
                             :bottom  ,ccoffice::+xl-valign-bottom+
                             :top     ,ccoffice::+xl-valign-top+))


(defun set-align-grid (wsheet x1 y1 x2 y2 &key
                                    (ha nil) (va nil) (hl nil) (vl nil) (around nil))
  (cclet* ((range (range wsheet x1 y1 x2 y2)))
    (when ha (setf (?'horizontalalignment range) (getf *alignments* ha)))
    (when va (setf (?'verticalalignment range) (getf *alignments* va)))
    (when hl (setf (?'colorindex (?'borders range ccoffice::+xl-inside-horizontal+)) ccoffice::+rgb-black+))
    (when vl (setf (?'colorindex (?'borders range ccoffice::+xl-inside-vertical+)) ccoffice::+rgb-black+))
    (when around (!'borderaround range 1 -4138))))


(defun rgb (r g b) (+ (ash b 16) (ash g 8) r))


(defun set-font (wsheet x1 y1 x2 y2 &key
                        (name nil) (size nil) (bold nil) (it nil) (ul nil)
                        (color nil) (bg nil))
  (cclet* ((range (range wsheet x1 y1 x2 y2))
           (font  (?'font range)))
    (when name (setf (?'name font) name))
    (when size (setf (?'size font) size))
    (setf (?'bold font) bold
          (?'italic font) it
          (?'underline font) ul)
    (when color (setf (?'color font) color))
    (when bg (setf (?'color (?'interior range)) bg))))


(defun merge-range (wsheet x1 y1 x2 y2)
  (cclet* ((range (range wsheet x1 y1 x2 y2))) (!'merge range)))


(defun set-col-widths (wsheet col &rest widths)
  (let ((start (resolve-column-designator col)))
    (loop for c from start
          for w in widths doing
          (cclet* ((range (range wsheet c 1)))
            (setf (?'columnwidth (?'columns (range wsheet c 1))) w)))))


(defun set-numform (wsheet x1 y1 x2 y2 number-format)
  (cclet* ((range (range wsheet x1 y1 x2 y2)))
    (setf (?'numberformat range) number-format)))
;    (setf (?'numberformat (?'cells range)) number-format)))



(defconstant +xl-validate-custom+         7)
(defconstant +xl-validate-date+           4)
(defconstant +xl-validate-decimal+        2)
(defconstant +xl-validate-input-only+     0)
(defconstant +xl-validate-list+           3)
(defconstant +xl-validate-text-length+    6)
(defconstant +xl-validate-time+           5)
(defconstant +xl-validate-whole-number+   1)
(defconstant +xl-valid-alert-information+ 3)
(defconstant +xl-valid-alert-stop+        1)
(defconstant +xl-valid-alert-warning+     2)
(defconstant +xl-between+                 1)
(defconstant +xl-equal+                   3)
(defconstant +xl-greater+                 5)
(defconstant +xl-greater-equal+           7)
(defconstant +xl-less+                    6)
(defconstant +xl-less-equal+              8)
(defconstant +xl-not-between+             2)
(defconstant +xl-not-equal+               4)


(defparameter *validation*
  `(:custom     ,+xl-validate-custom+
    :date       ,+xl-validate-date+
    :decimal    ,+xl-validate-decimal+
    :input-only ,+xl-validate-input-only+
    :list       ,+xl-validate-list+
    :textlen    ,+xl-validate-text-length+
    :time       ,+xl-validate-time+
    :wholenum   ,+xl-validate-whole-number+
    :alertinfo  ,+xl-valid-alert-information+
    :alertstop  ,+xl-valid-alert-stop+
    :alertwarn  ,+xl-valid-alert-warning+
    :between    ,+xl-between+
    :=          ,+xl-equal+
    :>          ,+xl-greater+
    :>=         ,+xl-greater-equal+
    :<          ,+xl-less+
    :<=         ,+xl-less-equal+
    :notbetween ,+xl-not-between+
    :/=         ,+xl-not-equal+
    nil         ,:empty))

    
(defun set-validation (wsheet x1 y1 x2 y2 type alert op form1 &optional (form2 :empty))
  (flet ((resolve-arg (arg) (getf *validation* arg)))
    (cclet* ((validation (?'validation (range wsheet x1 y1 x2 y2)))
             (type*      (resolve-arg type))
             (alert*     (resolve-arg alert))
             (op*        (resolve-arg op)))
      (!'delete validation)
      (!'add validation type* alert* op* form1 form2))))




;; ----------------------------------------------------------------------
;; LOCAL-TIME & time/date utils

(defun extort-tz (location-name)
  (let* ((repo-path local-time::*default-timezone-repository-path*)
         ;; Merge the location name into the Quicklisp zoneinfo directory
         (tz-file-path (merge-pathnames location-name repo-path)))
    ;; This reads the binary "TZif2" file directly and loads it into memory
    (local-time::%realize-timezone 
     (local-time::make-timezone :name location-name 
                                :path tz-file-path)
     t)))


(defun set-tz (location-name &key (reread-repo nil))
  (when reread-repo
    (local-time:reread-timezone-repository))
  (setf local-time:*default-timezone*
        (extort-tz location-name)))



;; ----------------------------------------------------------------------
;; Constructing output


(defun short-weekday (weekday)
  (cdr (assoc weekday (list (cons "Hétfõ" "H") (cons "Kedd" "K")
                            (cons "Szerda" "Sze") (cons "Csütörtök" "Cs")
                            (cons "Péntek" "P") (cons "Szombat" "Szo")
                            (cons "Vasárnap" "V"))
              :test #'string=)))


(defmethod daylist ((obj wax-app))
  (days-of-month (get-state obj :year)
                 (get-state obj :month)
                 :workdays-only (not (get-state obj :disp-holidays))))


(defun left-border (wsheet obj &optional (page 1))
#|  (let* ((days (days-of-month (get-state obj :year)
                              (get-state obj :month)
                              :workdays-only (not (get-state obj :disp-holidays))))|#
  (let* ((days (daylist obj))
         (last-row (+ 4 (* 2 (length days))))
         (voffset  (* last-row (1- page))))
    (setf (xcell wsheet :a (+ voffset 2)) "Nap")
    ;; A: dates and weekdays
    (loop for plist in days
          for r from (+ voffset 5) by 2
          for date = (getf plist :date)
          for short = (short-weekday (getf plist :weekday))
          doing (setf (xcell wsheet :a r) (format nil "'~a. ~a" date short)))
    ;; B: arrival/departure
    (loop for r from (+ voffset 5) upto (+ voffset last-row) doing
          (setf (xcell wsheet :b r) (if (oddp r) "Érkezés" "Távozás")))
    ;; Styling
    (set-align-grid wsheet :a (+ voffset 2) :b (+ voffset last-row) :ha :center :va :center :hl t :vl t :around t)
    (set-font wsheet :a (+ voffset 2) :a (+ voffset last-row) :bold t :color (rgb 255 0 255) :name "Times New Roman")
    (set-font wsheet :b (+ voffset 2) :b (+ voffset last-row) :size 7 :bg (rgb 200 200 150))
    (loop for r from (+ voffset 3) below (+ voffset last-row) by 2 doing
          (merge-range wsheet :a r :a (1+ r)))
    (merge-range wsheet :a (+ voffset 2) :a (+ voffset 4))
    (merge-range wsheet :b (+ voffset 2) :b (+ voffset 4))
    (set-col-widths wsheet :a 9.14 5.14)))
  

(defun name-header (wsheet obj name pos &optional (page 1))
  (let* ((last-row (+ 4 (* 2 (length (daylist obj)))))
         (voffset  (+ 3 (* last-row (1- page))))
         (hoffset  (+ 3 (* (1- pos) 3))))
    (setf (xcell wsheet hoffset voffset) name)
    (setf (xrange wsheet hoffset (1+ voffset) (+ hoffset 2) (1+ voffset))
          #2A(("Óra, perc" "Távollét oka" "Aláírás")))
    (set-align-grid wsheet hoffset voffset (+ hoffset 2) voffset
                    :ha :center :va :center :hl t :vl t :around t)
    (set-align-grid wsheet hoffset (1+ voffset) (+ hoffset 2) (1+ voffset)
                    :ha :center :va :center :hl t :vl t :around t)
    (set-font wsheet hoffset voffset (+ hoffset 2) voffset :bold t :color (rgb 10 20 30) :bg (rgb 250 240 230))
    (set-font wsheet hoffset (1+ voffset) (+ hoffset 2) (1+ voffset) :size 7 :bg (rgb 250 240 230))
    (merge-range wsheet hoffset voffset (+ hoffset 2) voffset)
    (set-col-widths wsheet hoffset 6.86 6.57 9.00)))

 xauniques ((obj xarray) column-designator &key (test #'equalp)


(defun name-column (wsheet obj name pos &optional (page 1))
  (let* ((days     (daylist obj))
         (last-row (+ 4 (* 2 (length days))))
         (voffset  (+ 5 (* last-row (1- page))))
         (hoffset  (+ 3 (* (1- pos) 3)))
         (row      (select-row-from obj :namelist #'(lambda (row) (string= (xcref row "Név") name))))
;         (list/    (xauniques (source-data obj :absence-types) "Rövidítés" :test #'string=))
         (list/    (ccoffice::xacolumn (source-data obj :absence-types) "Rövidítés"))
         (list*    (format nil "~{~a~^;~}" list/)))
#|    (do-xarows (row r (source-data obj :absence-types))
      (push (xcref row 0) list*))
    (setf list* (format nil "~{~a~^;~}" (nreverse list*)))|#
    (loop for r from voffset by 2
          for (nil nil nil nil nil nil nil nil nil workday nil last-workday) in days
          for arrival = (cond (last-workday (xcref row "Érkezés P"))
                              (workday      (xcref row "Érkezés H-Cs"))
                              (t            ""))
          for departure = (cond (last-workday (xcref row "Távozás P"))
                                (workday      (xcref row "Távozás H-Cs"))
                                (t            ""))
          doing (setf (xrange wsheet hoffset r hoffset (1+ r))
                      (make-array '(2 1) :initial-contents `((,arrival) (,departure)))))
    (set-numform wsheet hoffset voffset hoffset (+ voffset last-row -5) "ó:pp")
    (set-align-grid wsheet hoffset voffset (+ hoffset 2) (+ voffset last-row -5)
                    :ha :center :va :center :hl t :vl t :around t)
    (set-validation wsheet (1+ hoffset) voffset (1+ hoffset) (+ voffset last-row -6) 
                    :list :alertstop :between list*)
    (loop for r from voffset upto (+ voffset last-row -5) by 2 doing
          (merge-range wsheet (1+ hoffset) r (1+ hoffset) (1+ r)))))


(defun all-name-columns (wsheet obj)
  (let ((names (ccoffice::xacolumn (source-data obj :namelist) "Név"))
        (width 10)
        (page  1))
    (left-border wsheet obj page)
    (loop for name in names
          for pos from 1 doing
          (when (> pos width)
            (setf pos 1)
            (incf page)
            (left-border wsheet obj page))
          (name-header wsheet obj name pos page)
          (name-column wsheet obj name pos page))))
        



(defun construct (obj)
  (with-workbook (:wbook wbook :wsvars (ws1) :close nil)

#|    (left-border ws1 obj)
    (left-border ws1 obj 2)
    (left-border ws1 obj 3)
    (name-header ws1 obj "dr. Molnár-Rádi Andrea" 1 1)
    (name-column ws1 obj "dr. Molnár-Rádi Andrea" 1 1)
    (name-header ws1 obj "Gazda Mónika" 3 2)
    (name-column ws1 obj "Gazda Mónika" 3 2)|#
    (all-name-columns ws1 obj)

    ;; Make workbook visible
    (setf (?'visible (?'application wbook)) t)
    ))


;; ----------------------------------------------------------------------
;; Main


(defparameter *pkeys* '(:namelist-file :disp-holidays :year :month))

(defun start ()
  ;; App object ---------------------------------------------------------
  (let ((obj (make-instance 'wax-app
              :state `(:irreg-file     ,(appfile "_irreg_.lisp")
                       :namelist-file  ,(user-homedir)
                       :disp-holidays  t
                       :year           nil
                       :month          nil
                       )
              :execute-fn
              #'(lambda (obj &rest args)
                  (declare (ignore args))

                  ;; Loading irregulars
                  (destructuring-bind (extra-holidays extra-workdays)
                      (load-forms (get-state obj :irreg-file) :count 2)
                    (let ((*extra-holidays* extra-holidays)
                          (*extra-workdays* extra-workdays))

                      ;; Loading namelist file
                      (add-data-source obj :namelist (get-state obj :namelist-file))
                      (load-data-source obj :namelist)
                      (add-data-source obj :absence-types (get-state obj :namelist-file) 2)
                      (load-data-source obj :absence-types)

                      ;; Main thing
                      (construct obj)

                      ;; Cleanup
                      (purge-data-source obj :namelist)))))))

    (load-state obj :keys *pkeys*)
    ;; GUI --------------------------------------------------------------
    (wg-window
     `(:title "Jelenlét nyilvántartás"
       :max-height 80
       :best-width 650)

      "Névlista"
      (wg-file-selector
       "Névlista"
       "*.xlsx" '("Excel fájlok" "*.xlsx" "Minden fájl" "*.*")
       #'(lambda (text &rest rest)
           (declare (ignore rest))
           (setf (get-state obj :namelist-file) text))
       (get-state obj :namelist-file))



      "Év"
      (wg-text-input 
       #'(lambda (text &rest rest)
           (declare (ignore rest))
           (let ((year/ (parse-integer text :junk-allowed t)))
             (when (and (integerp year/)
                      (<= 1900 year/ 9999))
               (setf (get-state obj :year) year/))))
       (format nil "~a" (get-state obj :year)))

      "Hónap"
      (wg-text-input 
       #'(lambda (text &rest rest)
           (declare (ignore rest))
           (let* ((num-month (parse-integer text :junk-allowed t))
                  (month     (if (and (integerp num-month)
                                      (<= 1 num-month 12))
                               num-month
                               (identify-month text))))
             (when month
               (setf (get-state obj :month) month))))
       (format nil "~a" (get-state obj :month)))

      

      ""
      (wax::wg-checkbox
       "Munkaszüneti napok"
       #'(lambda (data)
           (setf (get-state obj :disp-holidays) data))
       (get-state obj :disp-holidays))
      
      ""
      (wg-button "Generálás"
        #'(lambda (interface)
            (declare (ignore interface))
            (save-state obj :keys *pkeys*)
            (wax-execute obj :errorsink-on nil))))))












